{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bannerforge_settlements:border_wall",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/bannerforge/settlements/particle/border_wall"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.life"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.w * 0.5",
          "variable.h * 0.5"
        ],
        "facing_camera_mode": "direction_x",
        "direction": {
          "mode": "custom",
          "custom_direction": [
            "variable.dir.x",
            "variable.dir.y",
            "variable.dir.z"
          ]
        },
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "0.12 * math.clamp(math.min(variable.particle_age, variable.particle_lifetime - variable.particle_age) / 0.2, 0, 1)"
        ]
      }
    }
  }
}

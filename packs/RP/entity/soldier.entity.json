{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "bannerforge_settlements:soldier",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "outfit_neutral": "textures/bannerforge/settlements/entity/npc/steward_neutral",
        "outfit_green": "textures/bannerforge/settlements/entity/npc/steward_green",
        "outfit_blue": "textures/bannerforge/settlements/entity/npc/steward_blue",
        "outfit_red": "textures/bannerforge/settlements/entity/npc/steward_red",
        "potion": "textures/bannerforge/settlements/entity/soldier_potion"
      },
      "geometry": {
        "default": "geometry.bannerforge_settlements.soldier",
        "potion": "geometry.bannerforge_settlements.soldier_potion"
      },
      "enable_attachables": true,
      "scripts": {
        "pre_animation": [
          "variable.gliding_speed_value = 1.0;",
          "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;",
          "variable.riding_y_offset = 0.5;"
        ],
        "animate": [
          "ctrl_look_at_target",
          "ctrl_move",
          "ctrl_riding",
          "ctrl_holding",
          "ctrl_brandish_spear",
          "ctrl_charging",
          "ctrl_attack",
          "ctrl_bob",
          "ctrl_bow_and_arrow",
          "ctrl_use_item_progress",
          {
            "block": "query.property('bannerforge_settlements:blocking')"
          },
          "ctrl_drink",
          {
            "engage": "query.has_target && !query.property('bannerforge_settlements:drinking') && !query.is_item_name_any('slot.weapon.mainhand', 0, 'minecraft:bow', 'minecraft:crossbow')"
          }
        ]
      },
      "animations": {
        "look_at_target_default": "animation.humanoid.look_at_target.default",
        "look_at_target_gliding": "animation.humanoid.look_at_target.gliding",
        "look_at_target_swimming": "animation.humanoid.look_at_target.swimming",
        "riding.arms": "animation.humanoid.riding.arms",
        "riding.legs": "animation.humanoid.riding.legs",
        "riding.body": "animation.humanoid.riding.body",
        "attack.rotations": "animation.bannerforge_settlements.soldier.swing",
        "ctrl_look_at_target": "controller.animation.humanoid.look_at_target",
        "ctrl_move": "controller.animation.humanoid.move",
        "ctrl_riding": "controller.animation.humanoid.riding",
        "ctrl_holding": "controller.animation.humanoid.holding",
        "ctrl_brandish_spear": "controller.animation.humanoid.brandish_spear",
        "ctrl_charging": "controller.animation.humanoid.charging",
        "ctrl_attack": "controller.animation.humanoid.attack",
        "ctrl_bob": "controller.animation.humanoid.bob",
        "ctrl_bow_and_arrow": "controller.animation.humanoid.bow_and_arrow",
        "ctrl_use_item_progress": "controller.animation.humanoid.use_item_progress",
        "move": "animation.humanoid.move",
        "holding": "animation.humanoid.holding",
        "brandish_spear": "animation.humanoid.brandish_spear",
        "charging": "animation.humanoid.charging",
        "bob": "animation.humanoid.bob",
        "bow_and_arrow": "animation.humanoid.bow_and_arrow",
        "use_item_progress": "animation.humanoid.use_item_progress",
        "block": "animation.bannerforge_settlements.soldier.block",
        "drink": "animation.bannerforge_settlements.soldier.drink",
        "ctrl_drink": "controller.animation.bannerforge_settlements.soldier.drink",
        "engage": "animation.bannerforge_settlements.soldier.engage"
      },
      "render_controllers": [
        "controller.render.bannerforge_settlements.npc",
        {
          "controller.render.bannerforge_settlements.soldier_potion": "query.property('bannerforge_settlements:drinking')"
        }
      ],
      "sound_effects": {
        "drink": "random.drink"
      }
    }
  }
}

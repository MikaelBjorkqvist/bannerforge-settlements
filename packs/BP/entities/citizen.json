          "component_groups": [
            "role_worker",
            "role_guard",
            "sched_wander",
            "sched_work",
            "sched_gather",
            "sched_home",
            "sched_bed"
          ]
        },
        "add": {
          "component_groups": [
            "role_settler",
            "sched_wander"
